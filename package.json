{
  "name": "@huzaigong/dsh-usage-dashboard",
  "version": "0.1.2",
  "description": "Whole-DSH usage aggregation: total tokens/cost across all sessions & workspaces, shown in Web Settings.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "scripts/link-deps.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "link-deps": "bash scripts/link-deps.sh"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}